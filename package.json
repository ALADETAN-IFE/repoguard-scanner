{
  "name": "@repoguard/scanner",
  "version": "1.0.0",
  "description": "Security scanner for detecting malicious code patterns in repositories",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "check-format": "prettier --check \"src/**/*.{ts,json}\"",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALADETAN-IFE/repoguard-scanner.git"
  },
  "bugs": {
    "url": "https://github.com/ALADETAN-IFE/repoguard-scanner/issues"
  },
  "homepage": "https://repoguard.ifecodes.xyz",
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@octokit/rest": "^22.0.1",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "tsup": "8.3.5",
    "typescript": "^5.7.2"
  }
}
